---
export interface Props {
  type: string;
}
const { type } = Astro.props;
---
<div style="background: var(--surface-1); border-left: 4px solid var(--primary); padding: 1.5rem; margin: 2rem 0; border-radius: 8px; box-shadow: var(--shadow-sm);">
  <h4 style="margin-top: 0; color: var(--text-heading); font-size: 1.25rem;">Calculadora de {type === 'juros' ? 'Juros Compostos' : 'Investimentos'}</h4>
  <p style="color: var(--text-body); margin-bottom: 1rem;">Quer ver na prática como isso afeta o seu dinheiro? Use nossa ferramenta gratuita para simular seus ganhos.</p>
  <a href="/ferramentas" style="display: inline-block; background: var(--primary); color: white; padding: 0.5rem 1rem; border-radius: 6px; text-decoration: none; font-weight: 600;">Acessar Ferramenta</a>
</div>
